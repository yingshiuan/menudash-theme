{
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#B04A2F"
				},
				{
					"slug": "primary-dark",
					"name": "Primary dark",
					"color": "#8A3822"
				},
				{
					"slug": "cream",
					"name": "Base",
					"color": "#FAF7F2"
				},
				{
					"slug": "paper",
					"name": "Paper",
					"color": "#F2ECE2"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "ink",
					"name": "Text",
					"color": "#2A2320"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#6F625B"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1180px"
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "clamp(1.25rem, 3vw, 2rem)"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "clamp(2rem, 5vw, 3.5rem)"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "clamp(3rem, 8vw, 6rem)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.375rem",
					"fluid": {
						"min": "1.2rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2.75rem",
					"fluid": {
						"min": "2rem",
						"max": "2.75rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "4.5rem",
					"fluid": {
						"min": "2.6rem",
						"max": "4.5rem"
					}
				}
			],
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "DM Sans",
					"fontFamily": "\"DM Sans\", \"Helvetica Neue\", Arial, \"PingFang TC\", \"Noto Sans TC\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontWeight": "100 1000",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/DMSans-Variable.woff2"
							]
						},
						{
							"fontFamily": "DM Sans",
							"fontWeight": "400",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/DMSans-Italic.woff2"
							]
						}
					]
				},
				{
					"slug": "display",
					"name": "Darker Grotesque",
					"fontFamily": "\"Darker Grotesque\", \"DM Sans\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Darker Grotesque",
							"fontWeight": "300 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/DarkerGrotesque-Variable.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Darker Grotesque",
							"fontWeight": "300 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/DarkerGrotesque-Variable-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--cream)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(16px, 4vw, 40px)",
				"right": "clamp(16px, 4vw, 40px)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-dark)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"lineHeight": "1"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--cream)"
				},
				"border": {
					"radius": "999px"
				},
				"spacing": {
					"padding": {
						"top": "0.8em",
						"bottom": "0.8em",
						"left": "1.6em",
						"right": "1.6em"
					}
				},
				"typography": {
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--ink)",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontWeight": "700",
					"fontSize": "1rem"
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-home",
			"title": "Home page (no title, full width)",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-wide",
			"title": "Wide page (menu)",
			"postTypes": [
				"page"
			]
		}
	]
}
